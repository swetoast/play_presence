[Unit]
Description=Play Presence for RG40XX V
After=local-fs.target network.target
Wants=network.target
StartLimitIntervalSec=600
StartLimitBurst=3
[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/rg40xx-game-presence
Environment=PYTHONPATH=/opt/rg40xx-game-presence/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 -m rg40xx_game_presence check-config --config /etc/rg40xx-game-presence/config.json
ExecStart=/usr/bin/python3 -m rg40xx_game_presence run --config /etc/rg40xx-game-presence/config.json
Restart=on-failure
RestartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
RuntimeDirectory=rg40xx-game-presence
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/opt/rg40xx-game-presence /mnt/mmc/Roms
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
